# Copiar a .env (no versionar). Los nombres coinciden con los *_env de config/sites/*.yaml.
SITE=pe

# --- Cloudflare (una cuenta por site) ---
CF_ACCOUNT_ID_PE=
CF_API_TOKEN_PE=
CF_BEACON_TOKEN_PE=

# --- AdSense ---
ADSENSE_CLIENT_PE=                 # ca-pub-XXXXXXXXXXXXXXXX
ADSENSE_SLOT_AFTER_RESULT_PE=
ADSENSE_SLOT_IN_BREAKDOWN_PE=
ADSENSE_SLOT_IN_ARTICLE_PE=
GA4_ID_PE=                         # opcional

# --- Telegram (un bot por site) ---
TELEGRAM_BOT_TOKEN_PE=
TELEGRAM_ADMIN_CHAT_ID_PE=

# --- Legal ---
CONTACT_EMAIL_PE=

# --- LLM (API compatible con OpenAI; NVIDIA por defecto) ---
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
# Borradores y uso general
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
# Extracción de normas (si falta, se usa LLM_MODEL)
LLM_MODEL_EXTRACT=nvidia/nemotron-3-ultra-550b-a55b
LLM_MAX_RPM=30
LLM_MAX_TOKENS=4000               # los modelos de razonamiento gastan tokens antes de responder
# Respaldo opcional (ej. Ollama local). Solo para borradores: la extracción de normas no lo usa.
LLM_FALLBACK_BASE_URL=http://localhost:11434/v1
LLM_FALLBACK_API_KEY=ollama
LLM_FALLBACK_MODEL=qwen2.5:7b-instruct

# --- Pipeline ---
# Fine-grained token solo para este repo. Permisos: Actions (read/write) para /deploy del bot;
# más adelante Contents y Pull requests (read/write) para los PR de parámetros.
GITHUB_TOKEN=
GITHUB_REPO=                       # dueño/repo; vacío = se toma del remoto origin
AUTO_MERGE_PARAMS=false
