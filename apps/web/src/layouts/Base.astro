---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";

interface Props {
  title: string;
  description: string;
  /** true para páginas que no deben indexarse (404, borradores). */
  noindex?: boolean;
  /** Imagen para redes sociales (ruta absoluta en el site). */
  ogImage?: string;
  /** Datos estructurados schema.org. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description, noindex = false, ogImage = "/og/inicio.png", jsonLd = [] } = Astro.props;
const imagen = new URL(ogImage, site.url).href;
const canonical = new URL(Astro.url.pathname, site.url).href;
const tituloCompleto = title === site.brand.name ? title : `${title} | ${site.brand.name}`;
const marca = `--brand:${site.brand.primary_color};--accent:${site.brand.accent_color}`;
const { adsense } = site;
const cargarAdsense = adsense.enabled && Boolean(adsense.client) && !adsense.preview && !import.meta.env.DEV;
---

<!doctype html>
<html lang={site.locale} style={marca}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={site.brand.primary_color} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale.replace("-", "_")} />
    <meta property="og:site_name" content={site.brand.name} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={tituloCompleto} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", ...d })} />)}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {
      cargarAdsense && (
        <script
          is:inline
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsense.client}`}
          crossorigin="anonymous"
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: 0.5rem;
    top: -3rem;
    background: var(--surface);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    z-index: 10;
  }
  .saltar:focus {
    top: 0.5rem;
  }
</style>
