---
import Base from "../layouts/Base.astro";
import AdSlot from "../components/AdSlot.astro";
import Guia from "../components/Guia.astro";
import { guiaDeCalculadora } from "../lib/guias";
import Calculadora from "../components/calc/Calculadora";
import { definicion } from "../calc";
import { site, type Calculadora as TCalc } from "../site.config";
import "../styles/calculadora.css";

// Una página por calculadora habilitada en el site que ya tenga formulario.
export function getStaticPaths() {
  return site.calculators.filter((c) => definicion(site.country, c.id)).map((c) => ({ params: { slug: c.slug }, props: { calc: c } }));
}

const { calc } = Astro.props as { calc: TCalc };
const { entities } = site.glossary;
const hoyBuild = new Date().toISOString().slice(0, 10);
const guia = await guiaDeCalculadora(calc.id);
const url = new URL(`/${calc.slug}/`, site.url).href;
const descripcion = `${calc.resumen} Calcula el monto con tu sueldo y mira el desglose paso a paso.`;

const jsonLd = [
  {
    "@type": "WebApplication",
    name: calc.title,
    url,
    description: descripcion,
    inLanguage: site.locale,
    applicationCategory: "FinanceApplication",
    operatingSystem: "Cualquiera (navegador web)",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: site.currency },
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: site.url + "/" },
      { "@type": "ListItem", position: 2, name: calc.nombre, item: url },
    ],
  },
];
---

<Base
  title={calc.title}
  description={descripcion}
  ogImage={`/og/${calc.slug}.png`}
  jsonLd={jsonLd}
  noindex={guia?.data.estado === "borrador"}
>
  <!--
    Privacidad (docs/09 §2): los datos de un enlace compartido (#sueldo=… o el formato antiguo ?sueldo=…)
    se guardan en memoria y se quitan de la barra de direcciones antes de que se ejecute cualquier otro
    script (analítica, anuncios). Se conservan los parámetros de campaña utm_*.
  -->
  <script is:inline slot="head">
    (function () {
      var calc = [], campana = [];
      location.search.slice(1).split("&").forEach(function (p) {
        if (p) (/^utm_/.test(p) ? campana : calc).push(p);
      });
      var h = location.hash.slice(1);
      if (h.indexOf("=") > -1) calc.push(h);
      window.__calcEstado = calc.join("&");
      if (calc.length) history.replaceState(null, "", location.pathname + (campana.length ? "?" + campana.join("&") : ""));
    })();
  </script>
  <div class="contenedor">
    <header class="encabezado">
      <nav class="migas" aria-label="Ruta"><a href="/">Inicio</a> / {calc.nombre}</nav>
      <h1>{calc.title}</h1>
      <p class="muted">{calc.resumen}</p>
    </header>

    <Calculadora
      client:load
      country={site.country}
      calcId={calc.id}
      titulo={calc.title}
      hoyBuild={hoyBuild}
      moneda={{ locale: site.locale, codigo: site.currency, simbolo: site.glossary.moneda.simbolo }}
    />

    <AdSlot posicion="after_result" />

    <p class="aviso">
      {`Cálculo referencial basado en la normativa vigente a la fecha indicada. No constituye asesoría legal. Ante dudas, consulta a ${entities.fiscalizador} o al ${entities.ministerio}.`}
    </p>

    {guia && <Guia guia={guia} />}
  </div>
</Base>

<style>
  .encabezado {
    padding-block: 1.5rem 1.25rem;
    max-width: 44rem;
  }
  .encabezado h1 {
    font-size: clamp(1.6rem, 1.2rem + 2vw, 2.2rem);
  }
  .encabezado p {
    margin: 0;
  }
  .migas {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }
  .migas a {
    color: inherit;
  }
  .aviso {
    color: var(--text-muted);
    font-size: 0.85rem;
    margin: 1.25rem 0 0;
    max-width: 44rem;
  }
</style>
