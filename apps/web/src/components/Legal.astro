---
import Base from "../layouts/Base.astro";

interface Props {
  title: string;
  description: string;
  actualizado: string;
}
const { title, description, actualizado } = Astro.props;
---

<Base title={title} description={description}>
  <article class="contenedor prosa">
    <h1>{title}</h1>
    <p class="muted">Última actualización: {actualizado}</p>
    <slot />
  </article>
</Base>
