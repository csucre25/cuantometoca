{
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm test:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint:*)",
      "Bash(npx vitest:*)",
      "Bash(npx astro:*)",
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run python -m pipeline.cli:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git log:*)",
      "Bash(git checkout -b:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force:*)",
      "Bash(wrangler pages deploy:*)",
      "Bash(rm -rf:*)",
      "Read(./.env.local)",
      "Read(./pipeline/data/**)"
    ]
  },
  "env": {
    "SITE": "pe"
  }
}
