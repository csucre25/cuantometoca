{
  "name": "calculadoras-laborales",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "pnpm -r --if-present test",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @calc/web typecheck",
    "validate-config": "tsx scripts/validate-config.ts",
    "build": "pnpm --filter @calc/web build",
    "dev": "pnpm --filter @calc/web dev"
  },
  "devDependencies": {
    "@calc/core": "workspace:*",
    "@types/node": "24.19.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "pnpm": {
    "packageExtensions": {
      "intl-messageformat@10": {
        "dependencies": {
          "tslib": "^2.6.0"
        }
      }
    }
  }
}
